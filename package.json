{
  "name": "moodtone",
  "version": "0.1.0",
  "type": "module",
  "description": "为 DeepSeek Harness 换一整套皮能：6 套情绪配色、9 个语义色自定义、7 种气泡样式与玻璃材质，全部存在本地。",
  "keywords": ["dsh", "dsh-plugin", "theme", "skin", "dark-mode", "moodtone"],
  "author": "芙落FLORT (https://github.com/ccflort)",
  "license": "MIT",
  "repository": { "type": "git", "url": "git+https://github.com/ccflort/moodtone.git" },
  "homepage": "https://github.com/ccflort/moodtone#readme",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": ["index.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
